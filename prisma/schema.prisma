model AutomationJob {
  id             String   @id @default(cuid()) @map("_id")
  providerId     String
  provider       CredentialingProvider @relation(fields: [providerId], references: [id], onDelete: Cascade)
  target         String   @default("caqh_proview")
  status         String   @default("pending") // pending | validating | validated | awaiting_mfa | processing | completed | failed
  mfaCode        String?
  mfaRequestedAt DateTime?
  mfaReceivedAt  DateTime?
  webhookToken   String   @unique
  logs           Json?    // [{ at, level, message }]
  error          String?
  package        Json?    // validated CAQH submission package for the external agent
  createdByName  String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  @@index([providerId])
  @@index([status])
}


model PtCptFee {
  id          String   @id @default(cuid()) @map("_id")
  code        String   @unique
  description String?
  chargeCents Int      @default(0)
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}


model PtNote {
  id               String    @id @default(cuid()) @map("_id")
  patientId        String
  legalCaseId      String?
  authorId         String
  authorName       String
  authorNpi        String?
  authorCredential String?
  authorLicense    String?
  visitDate        DateTime  @default(now())
  dateOfInjury     DateTime?
  mechanism        String?
  subjective       String?
  objective        String?
  assessment       String?
  plan             String?
  goals            String?
  causation        String?
  cptCodes         String[]
  icdCodes         String[]
  status           String    @default("draft")
  signedAt         DateTime?
  signedByName     String?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([legalCaseId])
  @@index([status])
}

// Separate, legally-formatted Personal Injury accident intake that flows into a PI note.
model PiIntake {
  id            String    @id @default(cuid()) @map("_id")
  patientId     String
  legalCaseId   String?
  accidentDate  DateTime?
  accidentTime  String?
  accidentType  String?
  location      String?
  description   String?
  role          String?
  seatbelt      Boolean?
  airbag        Boolean?
  policeReport  String?
  bodyParts     String[]
  painLevel     Int?
  priorInjuries String?
  autoInsurer   String?
  autoPolicy    String?
  claimNumber   String?
  adjuster      String?
  attorney      String?
  lawFirm       String?
  status        String    @default("submitted")
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  @@index([patientId])
  @@index([legalCaseId])
}
