// Proactive Clinic — data model
// PostgreSQL for Docker deployment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

model AppSetting {
  id        String   @id @default(cuid()) @map("_id")
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt
}

// Public "request a visit" submissions from the website (new or existing
// patients). Front desk reviews these and confirms/schedules them.
model AppointmentRequest {
  id               String   @id @default(cuid()) @map("_id")
  patientType      String   // "new" | "existing"
  firstName        String
  lastName         String
  phone            String?
  email            String?
  dob              String?
  mrn              String?
  matchedPatientId String?
  serviceInterest  String?
  preferredDate    String?
  preferredTime    String?
  message          String?
  priorityCheckin  Boolean  @default(false)
  status           String   @default("pending") // pending | confirmed | declined
  confirmation     String   @unique
  appointmentId    String?  // set when front desk converts this into a real Appointment
  scheduledStartsAt DateTime? // the scheduled time once converted
  emailStatus      String?  // sent | failed | skipped
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// -------------------------------------------------------------
// Reference / master data catalog (dropdown value sets)
// One flexible table powers every clinical & demographic dropdown.
// type examples: medication | diagnosis | allergen | allergyReaction |
//   allergySeverity | billingCode | problemStatus | language | race |
//   ethnicity | maritalStatus | usState | insurer | medForm | medRoute |
//   medFrequency | vaccine | sex | pronouns | apptLocation | serviceCategory
// system examples: ICD-10-CM | RxNorm | CPT | HCPCS | CVX | OMB | NUCC | local
// -------------------------------------------------------------
model RefData {
  id        String   @id @default(cuid()) @map("_id")
  type      String
  code      String?
  display   String
  system    String?
  data      Json?
  sortOrder Int      @default(0)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@unique([type, display])
  @@index([type])
}

// -------------------------------------------------------------
// Attorney portal: authorized attorneys request & download records
// -------------------------------------------------------------
model Attorney {
  id         String          @id @default(cuid()) @map("_id")
  name       String
  firm       String?
  email      String          @unique
  accessCode String
  active     Boolean         @default(true)
  createdAt  DateTime        @default(now())
  requests   RecordRequest[]
  legalCases LegalCase[]
}

model LegalCase {
  id               String    @id @default(cuid()) @map("_id")
  patientId        String
  patient          Patient   @relation(fields: [patientId], references: [id])
  attorneyId       String?
  attorney         Attorney? @relation(fields: [attorneyId], references: [id])
  caseNumber       String?
  caseType         String    @default("personal_injury") // personal_injury | workers_comp | auto_accident | other
  court            String?
  dateOfInjury     DateTime?
  lawFirm          String?
  claimNumber      String?
  adjuster         String?
  defendantInsurer String?
  status           String    @default("intake") // intake | treating | negotiating | settled | closed
  lienAmountCents  Int?
  notes            String?
  documents        CaseDocument[]
  events           CaseEvent[]
  offers           CaseOffer[]
  deliverables     CaseDeliverable[]
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  @@index([patientId])
  @@index([attorneyId])
  @@index([status])
}

model CaseDocument {
  id          String    @id @default(cuid()) @map("_id")
  legalCaseId String
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id])
  name        String
  category    String    @default("other") // intake | medical | billing | correspondence | court | other
  mimeType    String
  size        Int
  dataBase64  String    // stored in MongoDB so uploads survive in production
  uploadedBy  String?
  createdAt   DateTime  @default(now())

  @@index([legalCaseId])
}

model CaseEvent {
  id          String    @id @default(cuid()) @map("_id")
  legalCaseId String
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id])
  type        String    @default("note") // note | stage | notification | document | offer | deliverable
  title       String
  detail      String?
  actor       String?
  createdAt   DateTime  @default(now())

  @@index([legalCaseId])
}

model CaseOffer {
  id          String    @id @default(cuid()) @map("_id")
  legalCaseId String
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id])
  party       String    // clinic | attorney | insurer
  kind        String    // offer | counter | acceptance
  amountCents Int
  note        String?
  createdBy   String?
  createdAt   DateTime  @default(now())

  @@index([legalCaseId])
}

model CaseDeliverable {
  id          String    @id @default(cuid()) @map("_id")
  legalCaseId String
  legalCase   LegalCase @relation(fields: [legalCaseId], references: [id])
  title       String
  done        Boolean   @default(false)
  dueDate     DateTime?
  createdAt   DateTime  @default(now())

  @@index([legalCaseId])
}

model RecordRequest {
  id              String    @id @default(cuid()) @map("_id")
  attorneyId      String
  attorney        Attorney  @relation(fields: [attorneyId], references: [id])
  patientMrn      String
  patientLastName String
  reason          String?
  status          String    @default("pending") // pending | approved | denied
  decision        String?
  createdAt       DateTime  @default(now())
  decidedAt       DateTime?

  @@index([attorneyId])
  @@index([status])
}

// -------------------------------------------------------------
// Auth & Staff
// -------------------------------------------------------------
model User {
  id             String   @id @default(cuid()) @map("_id")
  email          String   @unique
  passwordHash   String
  firstName      String
  lastName       String
  role           String   // provider | nurse | frontdesk | billing | admin
  npi            String?  // for providers
  credential     String?  // MD, DO, NP, PA, RN, DPT, etc.
  specialty      String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now())

  appointments   Appointment[]   @relation("ProviderAppts")
  encounters     Encounter[]     @relation("EncounterProvider")
  ordersPlaced   Order[]         @relation("OrderProvider")
  notesAuthored  EncounterNote[] @relation("NoteAuthor")
  messagesFrom   Message[]       @relation("MsgFrom")
  messagesTo     Message[]       @relation("MsgTo")
  auditLogs      AuditLog[]
}

// -------------------------------------------------------------
// Patient & chart
// -------------------------------------------------------------
model Patient {
  id             String   @id @default(cuid()) @map("_id")
  mrn            String   @unique
  firstName      String
  lastName       String
  dob            DateTime
  sex            String   // M | F | X
  pronouns       String?
  email          String?
  phone          String?
  addressLine1   String?
  addressLine2   String?
  city           String?
  state          String?
  postalCode     String?
  country        String?  @default("US")
  preferredLang  String?  @default("English")
  ethnicity      String?
  race           String?
  maritalStatus  String?

  // insurance
  insurerName    String?
  insurerPlan    String?
  memberId       String?
  groupNumber    String?
  payerId        String?  // Stedi trading-partner / payer id used for eligibility & claims

  // emergency contact
  ecName         String?
  ecRelation     String?
  ecPhone        String?

  // registration type
  patientType    String   @default("clinical") // clinical | legal

  // status
  status         String   @default("active") // active | inactive | deceased
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  allergies      Allergy[]
  legalCases     LegalCase[]
  problems       Problem[]
  medications    Medication[]
  vitals         Vital[]
  immunizations  Immunization[]
  appointments   Appointment[]
  encounters     Encounter[]
  orders         Order[]
  documents      Document[]
  messages       Message[]
  careTeam       CareTeamMember[]
}

model CareTeamMember {
  id         String   @id @default(cuid()) @map("_id")
  patientId  String
  patient    Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  npi        String?
  name       String
  credential String?
  specialty  String?
  role       String?  // Referring | PCP | Specialist | Consultant | Other
  phone      String?
  address    String?
  source     String   @default("nppes")
  addedById  String?
  createdAt  DateTime @default(now())

  @@index([patientId])
}

model Allergy {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  substance    String
  reaction     String?
  severity     String?  // mild | moderate | severe | life-threatening
  onsetDate    DateTime?
  status       String   @default("active") // active | inactive | resolved
  notes        String?
  createdAt    DateTime @default(now())
}

model Problem {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  icd10        String?
  description  String
  status       String   @default("active") // active | inactive | resolved | chronic
  onsetDate    DateTime?
  resolvedDate DateTime?
  notes        String?
  createdAt    DateTime @default(now())
}

model Medication {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  name         String
  strength     String?
  form         String?  // tablet, capsule, cream, injection...
  sig          String?  // dose instructions
  route        String?  // PO, IM, IV, topical
  frequency    String?
  startDate    DateTime?
  endDate      DateTime?
  prescriberId String?
  status       String   @default("active") // active | discontinued | completed
  notes        String?
  createdAt    DateTime @default(now())
}

model Vital {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  takenAt      DateTime @default(now())
  heightCm     Float?
  weightKg     Float?
  bmi          Float?
  systolic     Int?
  diastolic    Int?
  pulse        Int?
  temperatureC Float?
  respRate     Int?
  spo2         Int?
  painScore    Int?
  notes        String?
}

model Immunization {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  vaccine      String
  cvxCode      String?
  givenAt      DateTime
  lot          String?
  site         String?
  notes        String?
}

// -------------------------------------------------------------
// Service catalog
// -------------------------------------------------------------
model ServiceType {
  id            String   @id @default(cuid()) @map("_id")
  code          String   @unique
  name          String
  category      String   // physical-therapy | wound-care | other-services | aesthetic-medicine | primary-care
  durationMin   Int      @default(45)
  description   String?
  homeEligible  Boolean  @default(false)
  defaultCpt    String?
  active        Boolean  @default(true)

  appointments  Appointment[]
}

// -------------------------------------------------------------
// Scheduling
// -------------------------------------------------------------
model Appointment {
  id             String      @id @default(cuid()) @map("_id")
  patientId      String
  patient        Patient     @relation(fields: [patientId], references: [id])
  providerId     String
  provider       User        @relation("ProviderAppts", fields: [providerId], references: [id])
  serviceTypeId  String?
  serviceType    ServiceType? @relation(fields: [serviceTypeId], references: [id])
  startsAt       DateTime
  endsAt         DateTime
  location       String?     // in-office | home-visit | telehealth
  status         String      @default("scheduled") // scheduled | checked-in | in-room | completed | no-show | cancelled
  reason         String?
  notes          String?
  createdAt      DateTime    @default(now())
  updatedAt      DateTime    @updatedAt

  encounter      Encounter[]
}

// -------------------------------------------------------------
// Encounters (visits) and SOAP
// -------------------------------------------------------------
model Encounter {
  id             String     @id @default(cuid()) @map("_id")
  patientId      String
  patient        Patient    @relation(fields: [patientId], references: [id])
  providerId     String
  provider       User       @relation("EncounterProvider", fields: [providerId], references: [id])
  appointmentId  String?
  appointment    Appointment? @relation(fields: [appointmentId], references: [id])
  visitType      String?    // office | telehealth | home | follow-up | new
  chiefComplaint String?
  startedAt      DateTime   @default(now())
  signedAt       DateTime?
  status         String     @default("open") // open | signed | amended

  // SOAP body (denormalized for fast load)
  subjective     String?
  objective      String?
  assessment     String?
  plan           String?
  ros            String?    // review of systems
  examFindings   String?
  familyHistory  String?
  socialHistory  String?
  qualityMeasures String?   // JSON array of checked measure keys
  noteFormat     String?    // soap | simple
  noteTypeId     String?
  simpleBody     String?    // body when noteFormat = simple
  encounterTypeId   String?
  encounterTypeName String?

  notes          EncounterNote[]
  diagnoses      EncounterDiagnosis[]
  charges        EncounterCharge[]
  orders         Order[]
}

model ChartNoteType {
  id        String   @id @default(cuid()) @map("_id")
  name      String
  format    String   @default("soap") // soap | simple
  isDefault Boolean  @default(false)
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
}

model EncounterType {
  id         String   @id @default(cuid()) @map("_id")
  name       String
  code       String?
  codeSystem String?  // SNOMED | CPT | HCPCS
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
  createdAt  DateTime @default(now())
}

model Template {
  id        String   @id @default(cuid()) @map("_id")
  kind      String   // charting | order | billing
  name      String
  ownerId   String?
  shared    Boolean  @default(false)
  shortcut  String?
  data      String   // JSON payload; shape depends on kind
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([kind])
}

model Addendum {
  id                    String   @id @default(cuid()) @map("_id")
  encounterId           String
  authorId              String?
  authorName            String?
  note                  String?
  prevEncounterTypeName String?
  newEncounterTypeName  String?
  createdAt             DateTime @default(now())

  @@index([encounterId])
}

model DxFavorite {
  id          String   @id @default(cuid()) @map("_id")
  userId      String
  icd10       String
  description String
  createdAt   DateTime @default(now())

  @@index([userId])
}

model EncounterNote {
  id           String     @id @default(cuid()) @map("_id")
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  authorId     String
  author       User       @relation("NoteAuthor", fields: [authorId], references: [id])
  body         String
  createdAt    DateTime   @default(now())
}

model EncounterDiagnosis {
  id           String     @id @default(cuid()) @map("_id")
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  icd10        String
  description  String
  primary      Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model EncounterCharge {
  id           String     @id @default(cuid()) @map("_id")
  encounterId  String
  encounter    Encounter  @relation(fields: [encounterId], references: [id], onDelete: Cascade)
  cpt          String
  description  String
  units        Int        @default(1)
  modifier     String?
  feeCents     Int        @default(0)
  createdAt    DateTime   @default(now())
}

// -------------------------------------------------------------
// Pharmacy directory (e-prescribe search & send)
// -------------------------------------------------------------
model Pharmacy {
  id           String   @id @default(cuid()) @map("_id")
  ncpdpId      String?  @unique // NCPDP / NABP pharmacy identifier
  npi          String?
  name         String
  network      String   @default("surescripts") // surescripts | availity | internal
  addressLine1 String?
  city         String?
  state        String?
  postalCode   String?
  phone        String?
  fax          String?
  hours        String?  // e.g. "24 hours", "Mon-Fri 8a-9p"
  services     String?  // comma list: delivery, compounding, drive-thru, specialty
  preferred    Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())

  orders       Order[]
}

// -------------------------------------------------------------
// Orders (Rx, Lab, Imaging, Procedure)
// -------------------------------------------------------------
model Order {
  id            String     @id @default(cuid()) @map("_id")
  patientId     String
  patient       Patient    @relation(fields: [patientId], references: [id])
  encounterId   String?
  encounter     Encounter? @relation(fields: [encounterId], references: [id])
  providerId    String
  provider      User       @relation("OrderProvider", fields: [providerId], references: [id])
  type          String     // rx | lab | imaging | referral | procedure
  status        String     @default("pending") // pending | sent | completed | cancelled
  createdAt     DateTime   @default(now())

  // common fields
  itemName      String     // medication name, lab panel name, imaging study, etc.
  itemCode      String?    // RxNorm, LOINC, CPT, etc.
  instructions  String?
  priority      String?    @default("routine") // routine | stat | urgent

  // rx-specific
  rxStrength    String?
  rxForm        String?
  rxSig         String?
  rxQty         String?
  rxRefills     Int?
  rxDispenseAsWritten Boolean? @default(false)

  // pharmacy routing (e-prescribe)
  pharmacyId     String?
  pharmacy       Pharmacy?  @relation(fields: [pharmacyId], references: [id])
  pharmacyName   String?    // denormalized for quick display
  routingNetwork String?    // surescripts | availity | internal
  routedAt       DateTime?

  // lab/imaging
  diagnosisCode String?
  resultText    String?
  resultAt      DateTime?
}

// -------------------------------------------------------------
// Inventory & stock (pharmacy dispensary, supplies, retail)
// -------------------------------------------------------------
model InventoryItem {
  id               String   @id @default(cuid()) @map("_id")
  sku              String   @unique
  name             String
  category         String   @default("supply") // medication | supply | retail | aesthetic | equipment
  form             String?  // tablet, vial, box, unit...
  strength         String?
  unit             String?  @default("each")
  quantityOnHand   Int      @default(0)
  reorderLevel     Int      @default(0)
  unitCostCents    Int      @default(0)
  retailPriceCents Int      @default(0)
  taxable          Boolean  @default(false)
  lotNumber        String?
  expiresAt        DateTime?
  location         String?  // dispensary, front-retail, aesthetics-room, supply-room
  supplier         String?
  controlled       Boolean  @default(false)
  active           Boolean  @default(true)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  movements        StockMovement[]
  saleLines        PosSaleLine[]
}

model StockMovement {
  id          String        @id @default(cuid()) @map("_id")
  itemId      String
  item        InventoryItem @relation(fields: [itemId], references: [id], onDelete: Cascade)
  type        String        // receive | adjust | dispense | sale | waste | count
  quantity    Int           // signed delta applied to quantityOnHand
  reason      String?
  reference   String?       // sale number, Rx id, PO, etc.
  actor       String?       // staff member name
  createdAt   DateTime      @default(now())
}

// -------------------------------------------------------------
// Point of Sale (retail checkout for products & services)
// -------------------------------------------------------------
model PosSale {
  id                  String   @id @default(cuid()) @map("_id")
  number              String   @unique
  status              String   @default("paid") // open | paid | refunded | void
  cashier             String?
  patientName         String?
  patientId           String?
  subtotalCents       Int      @default(0)
  discountCents       Int      @default(0)
  taxCents            Int      @default(0)
  totalCents          Int      @default(0)
  paymentMethod       String?  // cash | card | hsa-fsa | on-account
  amountTenderedCents Int      @default(0)
  changeCents         Int      @default(0)
  note                String?
  createdAt           DateTime @default(now())

  lines               PosSaleLine[]
}

model PosSaleLine {
  id             String         @id @default(cuid()) @map("_id")
  saleId         String
  sale           PosSale        @relation(fields: [saleId], references: [id], onDelete: Cascade)
  itemId         String?
  item           InventoryItem? @relation(fields: [itemId], references: [id])
  kind           String         @default("product") // product | service
  sku            String?
  description    String
  qty            Int            @default(1)
  unitPriceCents Int            @default(0)
  lineTotalCents Int            @default(0)
}

// -------------------------------------------------------------
// Messaging & docs
// -------------------------------------------------------------
model Message {
  id           String     @id @default(cuid()) @map("_id")
  fromUserId   String
  fromUser     User       @relation("MsgFrom", fields: [fromUserId], references: [id])
  toUserId     String?
  toUser       User?      @relation("MsgTo", fields: [toUserId], references: [id])
  patientId    String?
  patient      Patient?   @relation(fields: [patientId], references: [id])
  subject      String
  body         String
  read         Boolean    @default(false)
  createdAt    DateTime   @default(now())
}

model Document {
  id           String     @id @default(cuid()) @map("_id")
  patientId    String
  patient      Patient    @relation(fields: [patientId], references: [id])
  title        String
  category     String?    // consent | lab-report | imaging | referral | other
  body         String?    // text body or external URL
  createdAt    DateTime   @default(now())
}

// -------------------------------------------------------------
// Audit
// -------------------------------------------------------------
model AuditLog {
  id          String    @id @default(cuid()) @map("_id")
  userId      String?
  user        User?     @relation(fields: [userId], references: [id])
  action      String
  resource    String
  resourceId  String?
  meta        String?
  createdAt   DateTime  @default(now())
}


// -------------------------------------------------------------
// Revenue cycle — Stedi clearinghouse (eligibility, enrollment, claims, ERA)
// Decoupled from other models (plain string ids) for resilience.
// -------------------------------------------------------------

// Payer directory / per-payer configuration (Stedi payer id + transaction support).
model Payer {
  id                String   @id @default(cuid()) @map("_id")
  stediId           String?  // Stedi payer id / alias (tradingPartnerServiceId)
  name              String
  supportsEligibility Boolean @default(true)
  supportsClaims    Boolean  @default(true)
  supportsRemittance Boolean @default(false)
  active            Boolean  @default(true)
  notes             String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
  @@index([active])
}

// A saved real-time eligibility (270/271) result.
model EligibilityCheck {
  id            String   @id @default(cuid()) @map("_id")
  patientId     String?
  patientName   String?
  payerId       String   // tradingPartnerServiceId used
  payerName     String?
  memberId      String?
  status        String   @default("unknown") // active | inactive | error | unknown
  planName      String?
  summary       Json?    // normalized benefits summary
  raw           Json?    // full Stedi response
  checkedById   String?
  checkedByName String?
  createdAt     DateTime @default(now())
  @@index([patientId])
  @@index([createdAt])
}

// Stedi transaction enrollment tracking (provider + payer + transaction type).
model StediEnrollment {
  id               String   @id @default(cuid()) @map("_id")
  stediProviderId  String?  // Stedi provider record id
  stediEnrollmentId String? // Stedi enrollment id
  providerName     String
  npi              String
  taxId            String?
  payerId          String?
  payerName        String?
  transactions     Json?    // { eligibility, claims, claimPayment ... }
  status           String   @default("DRAFT") // DRAFT | STEDI_ACTION_REQUIRED | PROVIDER_ACTION_REQUIRED | PROVISIONING | LIVE | REJECTED | CANCELED
  raw              Json?
  createdById      String?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt
  @@index([status])
}

// A professional claim (837P) and its lifecycle.
model Claim {
  id                   String   @id @default(cuid()) @map("_id")
  patientControlNumber String   @unique
  patientId            String?
  patientName          String?
  encounterId          String?
  payerId              String
  payerName            String?
  status               String   @default("draft") // draft | submitted | accepted | rejected | paid | denied
  totalChargeCents     Int      @default(0)
  paidCents            Int      @default(0)
  diagnoses            Json?    // [{ qualifier, code }]
  serviceLines         Json?    // [{ serviceDate, procedureCode, chargeCents, units, diagnosisCodePointers, modifier }]
  submitRequest        Json?    // 837P payload sent
  submitResponse       Json?    // Stedi response
  statusResponse       Json?    // last 276/277 response
  eraTransactionId     String?
  createdById          String?
  createdByName        String?
  submittedAt          DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
  @@index([status])
  @@index([patientId])
  @@index([createdAt])
}

// Electronic remittance advice (835 / ERA) — payment tracking.
model Remittance {
  id             String   @id @default(cuid()) @map("_id")
  transactionId  String   @unique
  payerName      String?
  totalPaidCents Int      @default(0)
  checkNumber    String?
  paidDate       String?
  matchedClaims  Json?    // [{ patientControlNumber, payerClaimControlNumber, paidCents, status }]
  raw            Json?
  createdAt      DateTime @default(now())
  @@index([createdAt])
}

// Fee schedule / CPT code catalog (code normalization + default charges).
model FeeScheduleItem {
  id          String   @id @default(cuid()) @map("_id")
  code        String   // CPT/HCPCS code
  description String
  feeCents    Int      @default(0)
  modifier    String?
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  @@unique([code, modifier])
  @@index([active])
}

// External-EMR data import job tracking (Practice Fusion, eCW, generic CSV).
model ImportJob {
  id            String   @id @default(cuid()) @map("_id")
  source        String   // practice_fusion | ecw | csv
  entity        String   @default("patients")
  status        String   @default("completed") // completed | partial | failed
  total         Int      @default(0)
  created       Int      @default(0)
  skipped       Int      @default(0)
  failed        Int      @default(0)
  errors        Json?
  createdById   String?
  createdByName String?
  createdAt     DateTime @default(now())
  @@index([source])
}

// Organization bank account for payer EFT/ACH deposits. Sensitive numbers are
// stored server-side and only exposed masked (last4) to clients.
model BankAccount {
  id                String   @id @default(cuid()) @map("_id")
  label             String
  bankName          String?
  accountHolder     String?
  routingNumber     String?
  accountNumber     String?
  accountType       String   @default("checking") // checking | savings
  isDefault         Boolean  @default(false)
  active            Boolean  @default(true)
  createdById       String?
  createdByName     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt
}

// Per-payer EFT / ERA / claims enrollment tracking so remittances reconcile.
model PayerEftEnrollment {
  id             String    @id @default(cuid()) @map("_id")
  payerId        String?   // Stedi trading-partner id
  payerName      String
  enrollmentType String    @default("eft") // eft | era | claims
  bankAccountId  String?
  status         String    @default("not_started") // not_started | submitted | pending | active | rejected | cancelled
  effectiveDate  DateTime?
  traceNumber    String?
  contactEmail   String?
  contactPhone   String?
  notes          String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([payerId])
  @@index([status])
}

// Internal prior-authorization request tracker.
// NOTE: This is a MANUAL tracker for staff — it does NOT electronically submit a
// 278 authorization to the payer via Stedi (Stedi's integrated path does not
// expose self-service 278 submission). Staff obtain the auth via the payer
// portal/phone and record the outcome here so it is wired to the patient chart.
model PriorAuthRequest {
  id             String    @id @default(cuid()) @map("_id")
  patientId      String
  patientName    String?
  payerId        String?
  payerName      String?
  memberId       String?
  serviceType    String?   // e.g. PT evaluation, MRI lumbar
  cptCodes       String?   // comma-separated CPT/HCPCS
  diagnosisCodes String?   // comma-separated ICD-10
  units          Int?
  startDate      DateTime?
  endDate        DateTime?
  status         String    @default("draft") // draft | pending | submitted | approved | denied | expired
  authNumber     String?
  notes          String?
  createdById    String?
  createdByName  String?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  @@index([patientId])
  @@index([status])
}

// Patient financial ledger — charges, insurance payments (from ERA), adjustments.
model PatientLedgerEntry {
  id           String   @id @default(cuid()) @map("_id")
  patientId    String
  type         String   // charge | payment | adjustment
  amountCents  Int      @default(0) // always positive; sign implied by type
  description  String
  claimId      String?
  remittanceId String?
  refKey       String   @unique // idempotency key e.g. "charge:<claimId>" / "payment:<remittanceId>:<claimId>"
  date         DateTime @default(now())
  createdAt    DateTime @default(now())
  @@index([patientId])
}


// Live FHIR (SMART-on-FHIR) connection to an external EHR (Practice Fusion /
// Veradigm, or eClinicalWorks). Stores OAuth endpoint config + issued tokens.
// Secrets/tokens are only ever returned to clients MASKED.
model FhirConnection {
  id            String    @id @default(cuid()) @map("_id")
  provider      String    @unique // veradigm | ecw
  label         String?
  baseUrl       String?   // FHIR R4 base URL for the practice
  authUrl       String?   // SMART authorization endpoint
  tokenUrl      String?   // SMART token endpoint
  clientId      String?
  clientSecret  String?   // confidential apps only
  scopes        String?   // requested scopes, space-delimited
  // OAuth transaction state (short-lived, for the in-flight authorize->callback)
  pkceVerifier  String?
  oauthState    String?
  // Issued tokens after a successful connect
  accessToken   String?
  refreshToken  String?
  grantedScope  String?
  expiresAt     DateTime?
  status        String    @default("unconfigured") // unconfigured | configured | connected | error
  lastError     String?
  lastImportAt  DateTime?
  createdById   String?
  createdByName String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

// Progress tracker for a "pull every patient" bulk migration from a connected
// EHR over its FHIR API. One row per bulk run; the background worker updates it
// as it pages through patients so the admin UI can show live progress.
model FhirBulkJob {
  id                String    @id @default(cuid()) @map("_id")
  provider          String    // veradigm | ecw
  status            String    @default("running") // running | completed | failed | cancelled
  totalPatients     Int       @default(0)  // 0 = unknown / still estimating
  processed         Int       @default(0)
  patientsCreated   Int       @default(0)
  patientsMerged    Int       @default(0)
  recordsCreated    Int       @default(0)
  recordsSkipped    Int       @default(0)
  failed            Int       @default(0)
  limit             Int?      // optional cap for a trial run; null = import everyone
  currentPatient    String?
  errors            Json?     // [{ name, message }] (capped)
  notice            String?
  cancelRequested   Boolean   @default(false)
  defaultProviderId String?
  createdById       String?
  createdByName     String?
  startedAt         DateTime  @default(now())
  finishedAt        DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt
  @@index([provider])
  @@index([status])
}
