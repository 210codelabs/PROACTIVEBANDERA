  @@index([createdAt])
}

// E-Prescription (eRx) records — printable/exportable with e-signature.
model Prescription {
  id             String   @id @default(cuid()) @map("_id")
  patientId      String?
  patientName    String
  patientDob     String?
  patientAddress String?
  medName        String
  strength       String?
  form           String?
  ndc            String?
  sig            String?
  quantity       String?
  refills        Int      @default(0)
  daw            Boolean  @default(false)
  notes          String?
  pharmacyName   String?
  pharmacyAddress String?
  pharmacyNpi    String?
  pharmacyPhone  String?
  providerName   String
  providerNpi    String?
