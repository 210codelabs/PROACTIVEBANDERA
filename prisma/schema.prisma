  resultSummary      String?
  clinicNotes        String?
  createdByName       String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  enterprise         EnterpriseAccount @relation(fields: [enterpriseId], references: [id])
