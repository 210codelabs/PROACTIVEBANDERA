  lastName      String
  dob           DateTime?
  sex           String?  @default("X")
  email         String?
  phone         String?
  employeeNo    String?
  department    String?
  jobTitle      String?
  status        String   @default("active") // active | inactive
  accessEnabled Boolean  @default(false)
  accessCode    String?
  accessPinHash String?
  lastPortalLoginAt DateTime?
  createdByName String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  enterprise    EnterpriseAccount @relation(fields: [enterpriseId], references: [id])
  @@index([enterpriseId])
  @@index([patientId])
