  lastName          String
  credential        String?
  taxonomy          String?
  taxonomyCode      String?
  email             String?
  phone             String?
  addressLine1      String?
  city              String?
  state             String?
  postalCode        String?
  portalUsername    String?
  portalPasswordEnc String?  // AES-256-GCM ciphertext — never plaintext
