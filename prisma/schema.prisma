}

// -------------------------------------------------------------
// Clinical Specialties (Cardiology, Pediatrics, ...) with linked
// providers/specialists and connected patients.
// -------------------------------------------------------------
model Specialty {
  id          String   @id @default(cuid()) @map("_id")
  slug        String   @unique
